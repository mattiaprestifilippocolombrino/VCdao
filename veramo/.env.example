# ============================================================================
# VARIABILI D'AMBIENTE — Emissione VC EIP-712 per CompetenceDAO
# ============================================================================
# Copia questo file in .env e compila con i tuoi valori:
#   cp .env.example .env
#
# ⚠️  NON committare MAI il file .env su Git!
#     Il file .gitignore lo esclude già automaticamente.
# ============================================================================

# Chiave privata del trusted issuer configurato in GovernanceSkill.
DAO_ISSUER_PRIVATE_KEY=0xyour_32_byte_private_key

# Mnemonic usato dal nodo Hardhat per derivare i DID degli holder di test.
DAO_HARDHAT_MNEMONIC="your twelve word hardhat mnemonic"

# Chiave locale usata da Veramo per cifrare le chiavi private nel datastore.
# Generare 32 byte casuali, ad esempio con: openssl rand -hex 32
KMS_SECRET_KEY=your_32_byte_hex_secret

# Nodo Hardhat dal quale lo script verifica gli address degli holder.
DAO_HARDHAT_RPC_URL=http://127.0.0.1:8545
