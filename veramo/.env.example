# Chiave privata del trusted issuer configurato in GovernanceSkill.
DAO_ISSUER_PRIVATE_KEY=0xyour_32_byte_private_key

# Mnemonic usato dal nodo Hardhat per derivare i DID degli holder di test.
DAO_HARDHAT_MNEMONIC="your twelve word hardhat mnemonic"
